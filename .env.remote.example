# Dedicated remote DEVELOPMENT database. Never use a production database here.
APP_MODE=saas
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://st_jobs_app:REPLACE_ME@REPLACE_ME:5432/st_jobs_dev?sslmode=verify-full
# Owner connection for migrations only; use the provider's direct connection endpoint.
MIGRATION_DATABASE_URL=postgresql://DATABASE_OWNER:REPLACE_ME@REPLACE_ME:5432/st_jobs_dev?sslmode=verify-full
# Register http://localhost:3000/auth/google/callback with your Google OAuth client.
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
CREDENTIAL_ENCRYPTION_ACTIVE_KEY=v1
CREDENTIAL_ENCRYPTION_KEYS={"v1":"REPLACE_ME"}
TRUST_PROXY_HOPS=0
# Optional AI generation configuration (not inherited from .env).
OPENAI_API_KEY=
OPENAI_MODEL=
