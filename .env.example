# Use integration while developing; switch all credentials together for production.
ST_ENVIRONMENT=integration
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=

# The companion WordPress plugin supplies the post type and REST endpoint.
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_POST_TYPE_REST_BASE=st-jobs
WORDPRESS_POST_STATUS=draft
WORDPRESS_ZIP_ACF_FIELD_NAME=my_zip_codes

# OpenAI generates editable SEO title, excerpt, and project-story copy from trusted job data.
# Keep the API key server-side; it is never sent to the browser or WordPress.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ZIP city/state lookup uses Zippopotam.us and requires no API key.
# Override this only when using a compatible proxy or mirror.
# ZIP_LOOKUP_API_URL=https://api.zippopotam.us

# Alternatively, provide the full custom-post collection endpoint:
# WORDPRESS_API_URL=https://example.com/wp-json/wp/v2/st-jobs

# Sevalla sets PORT automatically. For local development, 3000 is the default.
# PORT=3000
# Account mode defaults to local in development and saas in production.
# See docs/development.md for database roles and Google OAuth setup.
# APP_MODE=saas
# APP_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql://st_jobs_app:REPLACE_ME@localhost:5432/st_jobs
# MIGRATION_DATABASE_URL=postgresql://DATABASE_OWNER:REPLACE_ME@localhost:5432/st_jobs
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CREDENTIAL_ENCRYPTION_ACTIVE_KEY=v1
# CREDENTIAL_ENCRYPTION_KEYS={"v1":"BASE64_32_BYTE_KEY"}
# TRUST_PROXY_HOPS=0

# Temporary testing only: enables signed-in users to add free job tokens.
# Disable before launching paid token purchases.
ENABLE_TEST_TOKENS=false

# Stripe subscriptions (SaaS mode). Use sandbox credentials for local testing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Each tier accepts a price ID or lookup key, e.g. subscription_basic.
# STRIPE_PRICE_TIER_1=
# STRIPE_PRICE_TIER_2=
# STRIPE_PRICE_TIER_3=
# Prices must be recurring, fixed, per-unit subscriptions; recurrence is set in Stripe. Metadata:
# Set token_count on each PRICE to its token allowance per paid billing cycle.
# Required server-wide maximum accumulated balance (choose your desired cap):
# MAX_TOKENS=900
# No publishable key is needed for server-created hosted Checkout redirects.

# Optional zero-cost recurring price for full Checkout testing (price ID or lookup key).
# STRIPE_PRICE_FREE=subscription_free
# Its Checkout button is enabled only when ENABLE_TEST_TOKENS=true.
